# Copy to .env.local for local dev. Set the same in Railway → Variables for production.
# Without RESEND_API_KEY, order/waitlist submissions are logged to the server console only.
RESEND_API_KEY=
NOTIFY_TO=hello@chupeynail.ca
NOTIFY_FROM="Chupey Nail <orders@chupeynail.ca>"
# Set to 1 on a demo/staging deploy so search engines ignore it. Remove at launch.
NOINDEX=
